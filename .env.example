# Supabase project → Settings → API
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
# Public site URL (used for OAuth / email redirects)
NEXT_PUBLIC_SITE_URL=http://localhost:3000
# Set to "true" after enabling a Phone (SMS) provider in Supabase Auth
NEXT_PUBLIC_ENABLE_PHONE_AUTH=false
# Set to "true" after enabling the Google provider in Supabase Auth
NEXT_PUBLIC_ENABLE_GOOGLE_AUTH=false
